[global]
    monitor = 0
    follow = keyboard
    origin = top-right
    offset = (16, 40)
    width = (300, 380)
    height = (0, 300)
    notification_limit = 5
    gap_size = 8
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 12

    frame_width = 2
    corner_radius = 10

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 5
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    font = JetBrains Mono 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    show_age_threshold = 60
    stack_duplicates = true

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark

    sticky_history = yes
    history_length = 20
    idle_threshold = 120

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1d1f21"
    foreground = "#969896"
    frame_color = "#373b41"
    highlight = "#81a2be"
    timeout = 5

[urgency_normal]
    background = "#1d1f21"
    foreground = "#c5c8c6"
    frame_color = "#81a2be"
    highlight = "#81a2be"
    timeout = 5

[urgency_critical]
    background = "#1d1f21"
    foreground = "#ffffff"
    frame_color = "#cc6666"
    highlight = "#cc6666"
    timeout = 10
